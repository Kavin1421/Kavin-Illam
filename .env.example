DATABASE_URL=
# Optional Atlas DB name (not a secret). Prefer encoding the DB in DATABASE_URL.
# MONGO_DB_NAME=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Production: set AUTH_URL / NEXTAUTH_URL to the public origin (e.g. https://illam.example.com)
# See docs/PRODUCTION.md

# Optional until later phases
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=

# Optional SMTP (if not using Resend yet)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
