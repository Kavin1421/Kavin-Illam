// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // native  = local macOS/Windows/Linux dev
  // debian  = Node bookworm Docker image (self-host)
  // rhel    = Netlify / AWS Lambda Node runtime
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProjectRole {
  OWNER
  ADMIN
  ENGINEER
  CONTRACTOR
  ARCHITECT
  ACCOUNTANT
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  RENOVATION
  OTHER
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum AccessRequestType {
  JOIN_PROJECT
  CREATE_PROJECT
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum Visibility {
  PRIVATE
  PROJECT_SHARED
  RESTRICTED
}

enum FinancialAccountType {
  BANK
  CASH
  CREDIT_CARD
  UPI
  OTHER
}

enum FinancialAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  REFUND
  ADJUSTMENT
  ADVANCE
  SETTLEMENT
}

enum TransactionDirection {
  OUTFLOW
  INFLOW
  INTERNAL
}

enum TransactionStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  PARTIALLY_PAID
  CANCELLED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  NEFT
  RTGS
  IMPS
  OTHER
}

enum AdvanceStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

enum AdvanceSettlementKind {
  SETTLEMENT
  REFUND
}

enum PaymentRequestStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  PAID
  PARTIALLY_PAID
  CANCELLED
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  /// bcrypt hash — never expose to the client
  passwordHash  String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  accounts            Account[]
  sessions            Session[]
  invitationsSent     Invitation[]    @relation("InvitationsSent")
  ownedProjects       Project[]       @relation("ProjectOwner")
  memberships         ProjectMember[] @relation("MemberUser")
  membersInvited      ProjectMember[] @relation("MemberInviter")
  financialAccounts   FinancialAccount[] @relation("FinancialAccountOwner")
  transactionsCreated FinancialTransaction[] @relation("TransactionCreator")
  transactionsPaid    FinancialTransaction[] @relation("TransactionPayer")
  transactionsApproved FinancialTransaction[] @relation("TransactionApprover")
  transactionsDeleted FinancialTransaction[] @relation("TransactionDeleter")
  advancesCreated     Advance[] @relation("AdvanceCreator")
  advancesDeleted     Advance[] @relation("AdvanceDeleter")
  advanceSettlementsCreated AdvanceSettlement[] @relation("AdvanceSettlementCreator")
  advancesReceived    Advance[] @relation("AdvanceRecipient")
  paymentRequestsCreated PaymentRequest[] @relation("PaymentRequestCreator")
  paymentRequestsReviewed PaymentRequest[] @relation("PaymentRequestReviewer")
  documentsCreated Document[] @relation("DocumentCreator")
  documentsUploaded Document[] @relation("DocumentUploader")
  documentVersionsUploaded DocumentVersion[] @relation("DocumentVersionUploader")
  documentAccesses DocumentAccess[] @relation("DocumentAccessUser")
  documentAccessesGranted DocumentAccess[] @relation("DocumentAccessGranter")
  budgetsCreated Budget[] @relation("BudgetCreator")
  milestonesCreated Milestone[] @relation("MilestoneCreator")
  tasksCreated Task[] @relation("TaskCreator")
  tasksAssigned Task[] @relation("TaskAssignee")
  auditLogs AuditLog[] @relation("AuditActor")
  activities Activity[] @relation("ActivityActor")
  accessRequestsRequested ProjectAccessRequest[] @relation("AccessRequestRequester")
  accessRequestsReviewed  ProjectAccessRequest[] @relation("AccessRequestReviewer")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

model Project {
  id                      String        @id @default(auto()) @map("_id") @db.ObjectId
  name                    String
  slug                    String        @unique
  description             String?
  projectType             ProjectType   @default(RESIDENTIAL)
  address                 String?
  startDate               DateTime?
  expectedCompletionDate  DateTime?
  actualCompletionDate    DateTime?
  /// Planned budget in minor units (paise for INR)
  estimatedBudget         Int?
  currency                String        @default("INR")
  status                  ProjectStatus @default(ACTIVE)
  ownerId                 String        @db.ObjectId
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  owner     User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   ProjectMember[]
  counters  ProjectCounter[]
  financialAccounts FinancialAccount[]
  categories Category[]
  transactions FinancialTransaction[]
  advances Advance[]
  advanceSettlements AdvanceSettlement[]
  paymentRequests PaymentRequest[]
  documents Document[]
  budgets Budget[]
  milestones Milestone[]
  tasks Task[]
  auditLogs AuditLog[]
  activities Activity[]
  accessRequests ProjectAccessRequest[]

  @@index([ownerId, status])
  @@index([status, updatedAt])
}

model ProjectAccessRequest {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  type                AccessRequestType
  status              AccessRequestStatus @default(PENDING)
  requesterId         String              @db.ObjectId
  /// Required when type = JOIN_PROJECT
  projectId           String?             @db.ObjectId
  requestedRole       ProjectRole         @default(ENGINEER)
  /// Required when type = CREATE_PROJECT
  proposedName        String?
  proposedType        ProjectType?
  proposedDescription String?
  proposedAddress     String?
  message             String?
  reviewedById        String?             @db.ObjectId
  reviewedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  requester User     @relation("AccessRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  User?    @relation("AccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([requesterId, status])
  @@index([projectId, status])
}

model ProjectMember {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String       @db.ObjectId
  userId      String       @db.ObjectId
  role        ProjectRole
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now())
  invitedById String?      @db.ObjectId
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("MemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([projectId, status])
}

model ProjectCounter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

/// Project-scoped invitation. projectId is required for new invites (Phase 3+).
model Invitation {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  name        String?
  role        ProjectRole      @default(ENGINEER)
  projectId   String?          @db.ObjectId
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String           @db.ObjectId
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  invitedBy User @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([projectId, status])
}

model FinancialAccount {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  projectId        String                  @db.ObjectId
  ownerId          String                  @db.ObjectId
  name             String
  type             FinancialAccountType    @default(BANK)
  institution      String?
  /// Masked account/UPI identifier only — never full credentials
  maskedIdentifier String?
  openingBalance   Int                     @default(0)
  currency         String                  @default("INR")
  status           FinancialAccountStatus  @default(ACTIVE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User                    @relation("FinancialAccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]

  @@index([projectId, status])
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /// null = system seed category available to all projects
  projectId   String?  @db.ObjectId
  code        String
  name        String
  parentId    String?  @db.ObjectId
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]
  paymentRequests PaymentRequest[]
  budgetCategories BudgetCategory[]

  @@index([projectId, isActive])
  @@index([code])
}

model FinancialTransaction {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String               @db.ObjectId
  transactionNumber String
  type              TransactionType
  direction         TransactionDirection
  /// Amount in minor units (paise for INR)
  amount            Int
  currency          String               @default("INR")
  categoryId        String?              @db.ObjectId
  accountId         String?              @db.ObjectId
  paidByUserId      String?              @db.ObjectId
  paidTo            String?
  recipientType     String?
  recipientId       String?              @db.ObjectId
  transactionDate   DateTime
  dueDate           DateTime?
  status            TransactionStatus    @default(PAID)
  paymentMethod     PaymentMethod?
  referenceNumber   String?
  description       String?
  notes             String?
  visibility        Visibility           @default(PROJECT_SHARED)
  allowedUserIds    String[]             @db.ObjectId
  createdById       String               @db.ObjectId
  approvedById      String?              @db.ObjectId
  approvedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  deletedById       String?              @db.ObjectId
  deletionReason    String?

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account   FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy User              @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  paidBy    User?             @relation("TransactionPayer", fields: [paidByUserId], references: [id], onDelete: SetNull)
  approvedBy User?            @relation("TransactionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  deletedBy User?             @relation("TransactionDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  advanceFunding Advance?     @relation("AdvanceFunding")
  advanceSettlement AdvanceSettlement? @relation("SettlementTransaction")
  paymentRequests PaymentRequest[] @relation("PaymentRequestTransaction")

  @@unique([projectId, transactionNumber])
  @@index([projectId, transactionDate])
  @@index([projectId, categoryId])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([projectId, visibility, createdById])
  @@index([projectId, type, status])
}

model Advance {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  projectId            String        @db.ObjectId
  advanceNumber        String
  /// Principal in minor units (paise). Source of truth for outstanding math.
  originalAmount       Int
  currency             String        @default("INR")
  recipientName        String?
  recipientUserId      String?       @db.ObjectId
  categoryId           String?       @db.ObjectId
  accountId            String?       @db.ObjectId
  issuedAt             DateTime
  description          String?
  notes                String?
  status               AdvanceStatus @default(OPEN)
  visibility           Visibility    @default(PROJECT_SHARED)
  allowedUserIds       String[]      @db.ObjectId
  /// Linked ledger ADVANCE transaction — same payment event, no duplicate silent rows
  fundingTransactionId String?       @unique @db.ObjectId
  createdById          String        @db.ObjectId
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  deletedById          String?       @db.ObjectId
  deletionReason       String?

  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fundingTransaction FinancialTransaction? @relation("AdvanceFunding", fields: [fundingTransactionId], references: [id], onDelete: SetNull)
  recipientUser      User?                 @relation("AdvanceRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  createdBy          User                  @relation("AdvanceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  deletedBy          User?                 @relation("AdvanceDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  settlements        AdvanceSettlement[]

  @@unique([projectId, advanceNumber])
  @@index([projectId, status])
  @@index([projectId, issuedAt])
  @@index([projectId, visibility, createdById])
}

model AdvanceSettlement {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String                @db.ObjectId
  advanceId     String                @db.ObjectId
  kind          AdvanceSettlementKind
  /// Amount in minor units (paise)
  amount        Int
  currency      String                @default("INR")
  settledAt     DateTime
  description   String?
  notes         String?
  /// Linked SETTLEMENT or REFUND ledger row
  transactionId String?               @unique @db.ObjectId
  createdById   String                @db.ObjectId
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  advance     Advance               @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  transaction FinancialTransaction? @relation("SettlementTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  createdBy   User                  @relation("AdvanceSettlementCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([advanceId, deletedAt])
  @@index([projectId, settledAt])
  @@index([projectId, kind])
}

model PaymentRequest {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  projectId            String               @db.ObjectId
  requestNumber        String
  title                String
  description          String?
  /// Requested amount in minor units (paise)
  amount               Int
  /// Cumulative paid amount in minor units
  paidAmount           Int                  @default(0)
  currency             String               @default("INR")
  categoryId           String?              @db.ObjectId
  accountId            String?              @db.ObjectId
  payeeName            String?
  dueDate              DateTime?
  status               PaymentRequestStatus @default(PENDING)
  visibility           Visibility           @default(PROJECT_SHARED)
  allowedUserIds       String[]             @db.ObjectId
  reviewNote           String?
  reviewedById         String?              @db.ObjectId
  reviewedAt           DateTime?
  /// Required before status can be PAID / PARTIALLY_PAID — no silent duplicate ledger
  /// (not @unique: MongoDB unique indexes reject multiple nulls)
  linkedTransactionId  String?              @db.ObjectId
  paidAt               DateTime?
  createdById          String               @db.ObjectId
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?

  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category          Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  linkedTransaction FinancialTransaction? @relation("PaymentRequestTransaction", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  createdBy         User                  @relation("PaymentRequestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reviewedBy        User?                 @relation("PaymentRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([projectId, requestNumber])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([projectId, visibility, createdById])
  @@index([linkedTransactionId])
}

enum DocumentCategory {
  CONTRACT
  BOND
  AGREEMENT
  INVOICE
  RECEIPT
  PAYMENT_PROOF
  QUOTATION
  ESTIMATE
  PLAN
  DRAWING
  APPROVAL
  GOVERNMENT_DOCUMENT
  IDENTITY_DOCUMENT
  WARRANTY
  CERTIFICATE
  PHOTO
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

model Document {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  projectId              String           @db.ObjectId
  documentNumber         String
  title                  String
  description            String?
  category               DocumentCategory @default(OTHER)
  tags                   String[]
  status                 DocumentStatus   @default(ACTIVE)
  visibility             Visibility       @default(PROJECT_SHARED)
  allowedUserIds         String[]         @db.ObjectId
  currentVersion         Int              @default(1)
  fileName               String
  mimeType               String
  fileSize               Int
  cloudinaryPublicId     String
  cloudinaryResourceType String
  cloudinaryDeliveryType String           @default("authenticated")
  format                 String?
  issueDate              DateTime?
  expiryDate             DateTime?
  renewalDate            DateTime?
  createdById            String           @db.ObjectId
  uploadedById           String           @db.ObjectId
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  archivedAt             DateTime?

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User              @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  uploadedBy User              @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  versions   DocumentVersion[]
  access     DocumentAccess[]

  @@unique([projectId, documentNumber])
  @@index([projectId, category])
  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([projectId, visibility, createdById])
}

model DocumentVersion {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId             String   @db.ObjectId
  projectId              String   @db.ObjectId
  versionNumber          Int
  fileName               String
  mimeType               String
  fileSize               Int
  cloudinaryPublicId     String
  cloudinaryResourceType String
  cloudinaryDeliveryType String   @default("authenticated")
  format                 String?
  changeDescription      String?
  uploadedById           String   @db.ObjectId
  createdAt              DateTime @default(now())
  isCurrent              Boolean  @default(false)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("DocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([projectId, documentId])
  @@index([documentId, isCurrent])
}

model DocumentAccess {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId  String   @db.ObjectId
  userId      String   @db.ObjectId
  grantedById String   @db.ObjectId
  createdAt   DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User     @relation("DocumentAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User     @relation("DocumentAccessGranter", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED
}

/// Explicit remaining modes — never mix committed and paid in one "remaining" figure without labeling.
enum BudgetRemainingMode {
  VS_PAID
  VS_COMMITTED
}

model Budget {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String              @db.ObjectId
  name          String
  currency      String              @default("INR")
  /// Optional override total; when null, sum of category planned amounts is used
  totalPlanned  Int?
  status        BudgetStatus        @default(ACTIVE)
  defaultRemainingMode BudgetRemainingMode @default(VS_PAID)
  notes         String?
  createdById   String              @db.ObjectId
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@index([projectId, status])
}

model BudgetCategory {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  budgetId      String   @db.ObjectId
  projectId     String   @db.ObjectId
  categoryId    String?  @db.ObjectId
  /// Display label (defaults to linked category name)
  label         String
  /// Planned amount in minor units (paise)
  plannedAmount Int
  sortOrder     Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  budget   Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([budgetId, sortOrder])
  @@index([projectId, categoryId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

model Milestone {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String          @db.ObjectId
  milestoneNumber String
  title       String
  description String?
  status      MilestoneStatus @default(UPCOMING)
  targetDate  DateTime?
  completedAt DateTime?
  sortOrder   Int             @default(0)
  visibility  Visibility      @default(PROJECT_SHARED)
  allowedUserIds String[]     @db.ObjectId
  createdById String          @db.ObjectId
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("MilestoneCreator", fields: [createdById], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, milestoneNumber])
  @@index([projectId, status])
  @@index([projectId, targetDate])
}

model Task {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String       @db.ObjectId
  taskNumber    String
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  milestoneId   String?      @db.ObjectId
  assigneeId    String?      @db.ObjectId
  dueDate       DateTime?
  completedAt   DateTime?
  visibility    Visibility   @default(PROJECT_SHARED)
  allowedUserIds String[]    @db.ObjectId
  createdById   String       @db.ObjectId
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([projectId, taskNumber])
  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([projectId, milestoneId])
  @@index([projectId, dueDate])
  @@index([projectId, visibility, createdById])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  REQUEST_CHANGES
  UPLOAD
  DOWNLOAD
  VIEW
  INVITE
  REMOVE_MEMBER
  CHANGE_PERMISSION
  PAYMENT
  SETTLEMENT
  RESTORE_VERSION
  ARCHIVE
  EXPORT
}

/// Security/finance-sensitive history. Never store secrets in metadata.
model AuditLog {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId  String      @db.ObjectId
  actorId    String      @db.ObjectId
  action     AuditAction
  entityType String
  entityId   String
  ip         String?
  userAgent  String?
  /// Safe diff / context only — redacted of secrets
  metadata   Json?
  createdAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, entityType, entityId])
  @@index([projectId, action, createdAt])
}

/// Human-readable project feed. Visibility mirrors the related resource.
model Activity {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  projectId      String     @db.ObjectId
  actorId        String     @db.ObjectId
  message        String
  entityType     String?
  entityId       String?
  href           String?
  visibility     Visibility @default(PROJECT_SHARED)
  /// Used with visibility checks (typically same as actorId)
  createdById    String     @db.ObjectId
  allowedUserIds String[]   @db.ObjectId
  createdAt      DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, visibility, createdById])
}
