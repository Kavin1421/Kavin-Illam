// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProjectRole {
  OWNER
  ADMIN
  ENGINEER
  CONTRACTOR
  ARCHITECT
  ACCOUNTANT
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  RENOVATION
  OTHER
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum Visibility {
  PRIVATE
  PROJECT_SHARED
  RESTRICTED
}

enum FinancialAccountType {
  BANK
  CASH
  CREDIT_CARD
  UPI
  OTHER
}

enum FinancialAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  REFUND
  ADJUSTMENT
  ADVANCE
  SETTLEMENT
}

enum TransactionDirection {
  OUTFLOW
  INFLOW
  INTERNAL
}

enum TransactionStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  PARTIALLY_PAID
  CANCELLED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  NEFT
  RTGS
  IMPS
  OTHER
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  /// bcrypt hash — never expose to the client
  passwordHash  String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  accounts            Account[]
  sessions            Session[]
  invitationsSent     Invitation[]    @relation("InvitationsSent")
  ownedProjects       Project[]       @relation("ProjectOwner")
  memberships         ProjectMember[] @relation("MemberUser")
  membersInvited      ProjectMember[] @relation("MemberInviter")
  financialAccounts   FinancialAccount[] @relation("FinancialAccountOwner")
  transactionsCreated FinancialTransaction[] @relation("TransactionCreator")
  transactionsPaid    FinancialTransaction[] @relation("TransactionPayer")
  transactionsApproved FinancialTransaction[] @relation("TransactionApprover")
  transactionsDeleted FinancialTransaction[] @relation("TransactionDeleter")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

model Project {
  id                      String        @id @default(auto()) @map("_id") @db.ObjectId
  name                    String
  slug                    String        @unique
  description             String?
  projectType             ProjectType   @default(RESIDENTIAL)
  address                 String?
  startDate               DateTime?
  expectedCompletionDate  DateTime?
  actualCompletionDate    DateTime?
  /// Planned budget in minor units (paise for INR)
  estimatedBudget         Int?
  currency                String        @default("INR")
  status                  ProjectStatus @default(ACTIVE)
  ownerId                 String        @db.ObjectId
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  owner     User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   ProjectMember[]
  counters  ProjectCounter[]
  financialAccounts FinancialAccount[]
  categories Category[]
  transactions FinancialTransaction[]

  @@index([ownerId, status])
  @@index([status, updatedAt])
}

model ProjectMember {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String       @db.ObjectId
  userId      String       @db.ObjectId
  role        ProjectRole
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now())
  invitedById String?      @db.ObjectId
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("MemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([projectId, status])
}

model ProjectCounter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

/// Project-scoped invitation. projectId is required for new invites (Phase 3+).
model Invitation {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  name        String?
  role        ProjectRole      @default(ENGINEER)
  projectId   String?          @db.ObjectId
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String           @db.ObjectId
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  invitedBy User @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([projectId, status])
}

model FinancialAccount {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  projectId        String                  @db.ObjectId
  ownerId          String                  @db.ObjectId
  name             String
  type             FinancialAccountType    @default(BANK)
  institution      String?
  /// Masked account/UPI identifier only — never full credentials
  maskedIdentifier String?
  openingBalance   Int                     @default(0)
  currency         String                  @default("INR")
  status           FinancialAccountStatus  @default(ACTIVE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User                    @relation("FinancialAccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]

  @@index([projectId, status])
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /// null = system seed category available to all projects
  projectId   String?  @db.ObjectId
  code        String
  name        String
  parentId    String?  @db.ObjectId
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]

  @@index([projectId, isActive])
  @@index([code])
}

model FinancialTransaction {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String               @db.ObjectId
  transactionNumber String
  type              TransactionType
  direction         TransactionDirection
  /// Amount in minor units (paise for INR)
  amount            Int
  currency          String               @default("INR")
  categoryId        String?              @db.ObjectId
  accountId         String?              @db.ObjectId
  paidByUserId      String?              @db.ObjectId
  paidTo            String?
  recipientType     String?
  recipientId       String?              @db.ObjectId
  transactionDate   DateTime
  dueDate           DateTime?
  status            TransactionStatus    @default(PAID)
  paymentMethod     PaymentMethod?
  referenceNumber   String?
  description       String?
  notes             String?
  visibility        Visibility           @default(PROJECT_SHARED)
  allowedUserIds    String[]             @db.ObjectId
  createdById       String               @db.ObjectId
  approvedById      String?              @db.ObjectId
  approvedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  deletedById       String?              @db.ObjectId
  deletionReason    String?

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account   FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy User              @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  paidBy    User?             @relation("TransactionPayer", fields: [paidByUserId], references: [id], onDelete: SetNull)
  approvedBy User?            @relation("TransactionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  deletedBy User?             @relation("TransactionDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([projectId, transactionNumber])
  @@index([projectId, transactionDate])
  @@index([projectId, categoryId])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([projectId, visibility, createdById])
  @@index([projectId, type, status])
}
