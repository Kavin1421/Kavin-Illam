// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProjectRole {
  OWNER
  ADMIN
  ENGINEER
  CONTRACTOR
  ARCHITECT
  ACCOUNTANT
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  RENOVATION
  OTHER
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  /// bcrypt hash — never expose to the client
  passwordHash  String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  accounts            Account[]
  sessions            Session[]
  invitationsSent     Invitation[]    @relation("InvitationsSent")
  ownedProjects       Project[]       @relation("ProjectOwner")
  memberships         ProjectMember[] @relation("MemberUser")
  membersInvited      ProjectMember[] @relation("MemberInviter")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

model Project {
  id                      String        @id @default(auto()) @map("_id") @db.ObjectId
  name                    String
  slug                    String        @unique
  description             String?
  projectType             ProjectType   @default(RESIDENTIAL)
  address                 String?
  startDate               DateTime?
  expectedCompletionDate  DateTime?
  actualCompletionDate    DateTime?
  /// Planned budget in minor units (paise for INR)
  estimatedBudget         Int?
  currency                String        @default("INR")
  status                  ProjectStatus @default(ACTIVE)
  ownerId                 String        @db.ObjectId
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  owner     User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   ProjectMember[]
  counters  ProjectCounter[]

  @@index([ownerId, status])
  @@index([status, updatedAt])
}

model ProjectMember {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String       @db.ObjectId
  userId      String       @db.ObjectId
  role        ProjectRole
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now())
  invitedById String?      @db.ObjectId
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("MemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([projectId, status])
}

model ProjectCounter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

/// Project-scoped invitation. projectId is required for new invites (Phase 3+).
model Invitation {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  name        String?
  role        ProjectRole      @default(ENGINEER)
  projectId   String?          @db.ObjectId
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String           @db.ObjectId
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  invitedBy User @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([projectId, status])
}
