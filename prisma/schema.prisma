// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Future project roles — used by invitations before full RBAC (Phase 3–4)
enum ProjectRole {
  OWNER
  ADMIN
  ENGINEER
  CONTRACTOR
  ARCHITECT
  ACCOUNTANT
  VIEWER
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  /// bcrypt hash — never expose to the client
  passwordHash  String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  accounts           Account[]
  sessions           Session[]
  invitationsSent    Invitation[] @relation("InvitationsSent")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

/// Platform / project invite foundation. projectId is optional until Phase 3.
model Invitation {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  name        String?
  role        ProjectRole      @default(ENGINEER)
  /// Set when inviting into a specific project (Phase 3+)
  projectId   String?          @db.ObjectId
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String           @db.ObjectId
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  invitedBy User @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([projectId, status])
}
